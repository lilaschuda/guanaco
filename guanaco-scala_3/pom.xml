<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.lilaschuda</groupId>
        <artifactId>guanaco-parent</artifactId>
        <version>1.2.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>guanaco-scala_3</artifactId>
    <packaging>jar</packaging>

    <name>guanaco-scala_3</name>
    <description>Optional Scala 3 ergonomics for Guanaco -- idiomatic factory functions, native extension-method
        outcome helpers, and CompletableFuture sugar for authoring routes and outcome types in Scala 3.
        A separate, independent module from guanaco-scala_2.13 (not a cross-build) -- add this dependency only
        if you author routes in Scala 3. guanaco-core never pulls it in transitively.</description>

    <dependencies>
        <!-- The contract this module wraps. -->
        <dependency>
            <groupId>io.github.lilaschuda</groupId>
            <artifactId>guanaco</artifactId>
            <version>${project.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>com.fasterxml.jackson.core</groupId>
                        <artifactId>jackson-annotations</artifactId>
                    </exclusion>
                </exclusions>
        </dependency>
        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala3-library_3</artifactId>
            <version>${scala3.version}</version>
        </dependency>
        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    
    <build>
        <!-- scala-maven-plugin's default source layout (src/main/scala, src/test/scala) is used as-is -
             unlike guanaco-kotlin, no <sourceDirectory> override should be needed here. To be confirmed
             once real code lands in Phase 2. -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <!-- Scala 3 doc generation: substantial progress made investigating a fork of
                scala-maven-plugin (net.alchim31.maven:scala-maven-plugin:4.9.11-guanaco.1),
                but not yet working end-to-end. Two real upstream bugs found and fixed in
                the fork: (1) ScalaDocMojo unconditionally emits Scala-2 doc flags
                (-doc-format/-doc-title) regardless of Scala major version - fixed via
                Context.version() branching, confirmed working; Scala 3 needs -project:VALUE
                (colon-joined single token, not addOption's space-separated form) instead.
                (2) ArtifactIds4Scala3.apidocMainClassName() returns "dotty.tools.dotc.Main"
                (the plain compiler) instead of the real doc tool "dotty.tools.scaladoc.Main" -
                which itself lives in a separate artifact (org.scala-lang:scaladoc_3) the
                plugin never declares as a dependency at all. Both required plain POM
                configuration once identified (scaladocClassName, sourceDir pointed at
                compiled .tasty output, an extra <dependencies> entry) - no further fork
                changes needed for this part.
                Currently blocked by a third, separate problem: dotty.tools.scaladoc's
                optional static-site/blog renderer unconditionally initializes on every run
                (HtmlRenderer's constructor touches StaticSiteContext.staticSiteRoot
                regardless of whether -siteroot points at empty content), and that code
                path needs a Jackson 3.x-era jackson-annotations release containing
                JsonSerializeAs - which Guanaco's own Camel/Spring-driven jackson-annotations
                2.22 does not have, causing a NoClassDefFoundError. scala-maven-plugin
                unconditionally merges the full project compile classpath into the
                scaladoc invocation with no opt-out (ScalaDocMojo.java:162), so Guanaco's
                own real Jackson dependency shadows whatever scaladoc_3 needs. Excluding
                jackson-annotations from the guanaco dependency in this module's own POM
                was tried and had zero effect - the real conflicting classpath entry
                was not conclusively identified. See SCALA_INTEROP.md for the full
                write-up before continuing this investigation. -->
            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
                <version>${scala-maven-plugin.version}</version>
                <configuration>
                    <scalaVersion>${scala3.version}</scalaVersion>
                    <compileOrder>Mixed</compileOrder>
                </configuration>
                <executions>
                    <execution>
                        <id>scala-compile</id>
                        <goals>
                            <goal>compile</goal>
                            <goal>testCompile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>doc-jar</goal>
                        </goals>
<!--                        <configuration>
                            <scaladocClassName>dotty.tools.scaladoc.Main</scaladocClassName>
                            <sourceDir>${project.build.outputDirectory}</sourceDir>
                            <includes>
                                <include>**/*.tasty</include>
                            </includes>
                            <dependencies>
                                <dependency>
                                    <groupId>org.scala-lang</groupId>
                                    <artifactId>scaladoc_3</artifactId>
                                    <version>${scala3.version}</version>
                                </dependency>
                            </dependencies>
                                <args>
                                    <arg>-siteroot</arg>
                                    <arg>${project.basedir}/target/scaladoc-empty-site</arg>
                                </args>
                        </configuration>-->
                    </execution>
<!--                    <execution>
                        <id>ensure-siteroot-dir</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.basedir}/target/scaladoc-empty-site"/>
                            </target>
                        </configuration>
                    </execution>-->
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <configuration>
                            <!-- javac's javadoc tool cannot process Scala source, same class of
                                 problem confirmed empirically for guanaco-kotlin. Scaladoc generation
                                 (scala:doc) and cross-linking is deferred to its own phase, not yet
                                 wired here. -->
                            <skip>true</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
