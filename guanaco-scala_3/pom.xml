<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.lilaschuda</groupId>
        <artifactId>guanaco-parent</artifactId>
        <version>1.2.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>guanaco-scala_3</artifactId>
    <packaging>jar</packaging>

    <name>guanaco-scala_3</name>
    <description>Optional Scala 3 ergonomics for Guanaco -- idiomatic factory functions, native extension-method
        outcome helpers, and CompletableFuture sugar for authoring routes and outcome types in Scala 3.
        A separate, independent module from guanaco-scala_2.13 (not a cross-build) -- add this dependency only
        if you author routes in Scala 3. guanaco-core never pulls it in transitively.</description>

    <dependencies>
        <!-- The contract this module wraps. -->
        <dependency>
            <groupId>io.github.lilaschuda</groupId>
            <artifactId>guanaco</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala3-library_3</artifactId>
            <version>${scala3.version}</version>
        </dependency>
        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- scala-maven-plugin's default source layout (src/main/scala, src/test/scala) is used as-is -
             unlike guanaco-kotlin, no <sourceDirectory> override should be needed here. To be confirmed
             once real code lands in Phase 2. -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <!-- scala:doc is currently unusable for this module: scala-maven-plugin
            4.9.10's doc goal generates Scala-2-vocabulary flags (-doc-format,
            -doc-title) that Scala 3.9.0's scaladoc tool rejects outright -
            confirmed by the bare goal (zero custom args) failing identically to
            a fully-configured attempt. Not a flag-syntax issue on our end; a
            real plugin/compiler version mismatch, and 4.9.10 is already the
            latest scala-maven-plugin release, so there's no newer version to
            try. Deferred to feature/guanaco-scala for investigation into a
            doc-generation alternative - see that branch before revisiting. -->
            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
                <version>${scala-maven-plugin.version}</version>
                <configuration>
                    <scalaVersion>${scala3.version}</scalaVersion>
                    <compileOrder>Mixed</compileOrder>
                </configuration>
                <executions>
                    <execution>
                        <id>scala-compile</id>
                        <goals>
                            <goal>compile</goal>
                            <goal>testCompile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <configuration>
                            <!-- javac's javadoc tool cannot process Scala source, same class of
                                 problem confirmed empirically for guanaco-kotlin. Scaladoc generation
                                 (scala:doc) and cross-linking is deferred to its own phase, not yet
                                 wired here. -->
                            <skip>true</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
